<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.*?>
<BorderPane
        prefHeight="800.0"
        prefWidth="1280.0"
        style="-fx-background-color: #090909;"
        stylesheets="@style.css"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.ale.tuney.controller.EditProfileController">

    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background: #141414; -fx-background-color: #141414; -fx-border-color: transparent; -fx-border-width: 0; -fx-background-insets: 0; -fx-padding: 0; -fx-background-radius: 16;"
                    BorderPane.alignment="CENTER">
            <content>
                <VBox style="-fx-background-color: #141414; -fx-background-radius: 16;"
                      alignment="TOP_CENTER" spacing="24.0">

            <padding><Insets bottom="40.0" left="40.0" right="40.0" top="32.0" /></padding>

            <children>
                <!-- HEADER -->
                <HBox alignment="CENTER_LEFT" spacing="16.0" maxWidth="500.0">
                    <children>
                        <HBox onMouseClicked="#cancelArrow" styleClass="menu-item" prefWidth="36.0" prefHeight="36.0" alignment="CENTER">
                            <children>
                                <SVGPath content="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" fill="white" scaleX="0.85" scaleY="0.85"/>
                            </children>
                        </HBox>
                        <Label text="Modifica profilo" textFill="WHITE">
                            <font><Font size="24.0" /></font>
                        </Label>
                    </children>
                </HBox>

                <!-- FOTO PROFILO -->
                <VBox alignment="CENTER" spacing="12.0">
                    <children>
                        <StackPane prefWidth="120.0" prefHeight="120.0" alignment="CENTER">
                            <children>
                                <Circle radius="60" fill="#3a3a3a" />
                                <ImageView fx:id="profileImagePreview" fitHeight="120.0" fitWidth="120.0"
                                           pickOnBounds="true" preserveRatio="true" />
                            </children>
                        </StackPane>
                        <HBox alignment="CENTER" spacing="12.0">
                            <children>
                                <Button text="Cambia foto" onAction="#chooseImage"
                                        style="-fx-background-color: transparent; -fx-text-fill: #9b6fd4; -fx-border-color: #9b6fd4; -fx-border-radius: 16; -fx-background-radius: 16; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 6 18 6 18;" />
                                <Button text="Rimuovi foto" onAction="#removeImage"
                                        style="-fx-background-color: transparent; -fx-text-fill: #ff5555; -fx-border-color: #ff5555; -fx-border-radius: 16; -fx-background-radius: 16; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 6 18 6 18;" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- CAMPI -->
                <VBox spacing="20.0" maxWidth="500.0">
                    <children>
                        <VBox spacing="6.0">
                            <children>
                                <Label text="Nome" textFill="#888888">
                                    <font><Font size="13.0" /></font>
                                </Label>
                                <TextField fx:id="nameField" promptText="Il tuo nome"
                                           style="-fx-background-color: #090909; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10;">
                                    <font><Font size="14.0" /></font>
                                </TextField>
                            </children>
                        </VBox>

                        <VBox spacing="6.0">
                            <children>
                                <Label text="Username" textFill="#888888">
                                    <font><Font size="13.0" /></font>
                                </Label>
                                <TextField fx:id="usernameField" editable="false"
                                           style="-fx-background-color: #1a1a1a; -fx-text-fill: #888888; -fx-background-radius: 10; -fx-padding: 10;">
                                    <font><Font size="14.0" /></font>
                                </TextField>
                            </children>
                        </VBox>

                        <VBox spacing="6.0">
                            <children>
                                <Label text="Bio" textFill="#888888">
                                    <font><Font size="13.0" /></font>
                                </Label>
                                <TextArea fx:id="bioField" promptText="Scrivi qualcosa su di te..."
                                          wrapText="true" prefHeight="90.0"
                                          style="-fx-background-color: #090909; -fx-text-fill: white; -fx-background-radius: 10; -fx-control-inner-background: #090909;">
                                    <font><Font size="14.0" /></font>
                                </TextArea>
                                <Label fx:id="bioCounterLabel" text="0/150" textFill="#666666" alignment="CENTER_RIGHT" maxWidth="Infinity">
                                    <font><Font size="12.0" /></font>
                                </Label>
                            </children>
                        </VBox>

                        <!-- BRANI/ALBUM PREFERITI -->
                        <VBox spacing="10.0">
                            <children>
                                <Label text="Brani/Album Preferiti (Max 4)" textFill="#888888">
                                    <font><Font size="13.0" /></font>
                                </Label>

                                <!-- Slot 1 -->
                                <VBox spacing="6.0" style="-fx-background-color: #090909; -fx-padding: 8; -fx-background-radius: 10;">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label text="1." textFill="#888888" />
                                                <ImageView fx:id="fav1Cover" fitWidth="40" fitHeight="40" preserveRatio="true" />
                                                <VBox HBox.hgrow="ALWAYS" spacing="2">
                                                    <children>
                                                        <Label fx:id="fav1Title" text="Nessun elemento selezionato" textFill="WHITE" style="-fx-font-weight: bold;"/>
                                                        <Label fx:id="fav1Artist" text="Cerca per aggiungere" textFill="#888888" style="-fx-font-size: 12;"/>
                                                    </children>
                                                </VBox>
                                                <Button fx:id="fav1RemoveBtn" text="Rimuovi" visible="false" managed="false" onAction="#removeFav1" style="-fx-background-color: #ff5555; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" />
                                            </children>
                                        </HBox>
                                        <HBox fx:id="fav1SearchBox" spacing="8.0" alignment="CENTER_LEFT">
                                            <children>
                                                <TextField fx:id="fav1SearchField" promptText="Cerca un brano o album..." HBox.hgrow="ALWAYS" style="-fx-background-color: #1a1a1a; -fx-text-fill: white; -fx-background-radius: 8;" />
                                            </children>
                                        </HBox>
                                        <ListView fx:id="fav1Results" prefHeight="100" visible="false" managed="false" style="-fx-background-color: #1a1a1a;" />
                                    </children>
                                </VBox>

                                <!-- Slot 2 -->
                                <VBox spacing="6.0" style="-fx-background-color: #090909; -fx-padding: 8; -fx-background-radius: 10;">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label text="2." textFill="#888888" />
                                                <ImageView fx:id="fav2Cover" fitWidth="40" fitHeight="40" preserveRatio="true" />
                                                <VBox HBox.hgrow="ALWAYS" spacing="2">
                                                    <children>
                                                        <Label fx:id="fav2Title" text="Nessun elemento selezionato" textFill="WHITE" style="-fx-font-weight: bold;"/>
                                                        <Label fx:id="fav2Artist" text="Cerca per aggiungere" textFill="#888888" style="-fx-font-size: 12;"/>
                                                    </children>
                                                </VBox>
                                                <Button fx:id="fav2RemoveBtn" text="Rimuovi" visible="false" managed="false" onAction="#removeFav2" style="-fx-background-color: #ff5555; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" />
                                            </children>
                                        </HBox>
                                        <HBox fx:id="fav2SearchBox" spacing="8.0" alignment="CENTER_LEFT">
                                            <children>
                                                <TextField fx:id="fav2SearchField" promptText="Cerca un brano o album..." HBox.hgrow="ALWAYS" style="-fx-background-color: #1a1a1a; -fx-text-fill: white; -fx-background-radius: 8;" />
                                            </children>
                                        </HBox>
                                        <ListView fx:id="fav2Results" prefHeight="100" visible="false" managed="false" style="-fx-background-color: #1a1a1a;" />
                                    </children>
                                </VBox>

                                <!-- Slot 3 -->
                                <VBox spacing="6.0" style="-fx-background-color: #090909; -fx-padding: 8; -fx-background-radius: 10;">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label text="3." textFill="#888888" />
                                                <ImageView fx:id="fav3Cover" fitWidth="40" fitHeight="40" preserveRatio="true" />
                                                <VBox HBox.hgrow="ALWAYS" spacing="2">
                                                    <children>
                                                        <Label fx:id="fav3Title" text="Nessun elemento selezionato" textFill="WHITE" style="-fx-font-weight: bold;"/>
                                                        <Label fx:id="fav3Artist" text="Cerca per aggiungere" textFill="#888888" style="-fx-font-size: 12;"/>
                                                    </children>
                                                </VBox>
                                                <Button fx:id="fav3RemoveBtn" text="Rimuovi" visible="false" managed="false" onAction="#removeFav3" style="-fx-background-color: #ff5555; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" />
                                            </children>
                                        </HBox>
                                        <HBox fx:id="fav3SearchBox" spacing="8.0" alignment="CENTER_LEFT">
                                            <children>
                                                <TextField fx:id="fav3SearchField" promptText="Cerca un brano o album..." HBox.hgrow="ALWAYS" style="-fx-background-color: #1a1a1a; -fx-text-fill: white; -fx-background-radius: 8;" />
                                            </children>
                                        </HBox>
                                        <ListView fx:id="fav3Results" prefHeight="100" visible="false" managed="false" style="-fx-background-color: #1a1a1a;" />
                                    </children>
                                </VBox>

                                <!-- Slot 4 -->
                                <VBox spacing="6.0" style="-fx-background-color: #090909; -fx-padding: 8; -fx-background-radius: 10;">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label text="4." textFill="#888888" />
                                                <ImageView fx:id="fav4Cover" fitWidth="40" fitHeight="40" preserveRatio="true" />
                                                <VBox HBox.hgrow="ALWAYS" spacing="2">
                                                    <children>
                                                        <Label fx:id="fav4Title" text="Nessun elemento selezionato" textFill="WHITE" style="-fx-font-weight: bold;"/>
                                                        <Label fx:id="fav4Artist" text="Cerca per aggiungere" textFill="#888888" style="-fx-font-size: 12;"/>
                                                    </children>
                                                </VBox>
                                                <Button fx:id="fav4RemoveBtn" text="Rimuovi" visible="false" managed="false" onAction="#removeFav4" style="-fx-background-color: #ff5555; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" />
                                            </children>
                                        </HBox>
                                        <HBox fx:id="fav4SearchBox" spacing="8.0" alignment="CENTER_LEFT">
                                            <children>
                                                <TextField fx:id="fav4SearchField" promptText="Cerca un brano o album..." HBox.hgrow="ALWAYS" style="-fx-background-color: #1a1a1a; -fx-text-fill: white; -fx-background-radius: 8;" />
                                            </children>
                                        </HBox>
                                        <ListView fx:id="fav4Results" prefHeight="100" visible="false" managed="false" style="-fx-background-color: #1a1a1a;" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <Label fx:id="errorLabel" textFill="#ff5555" visible="false" managed="false" wrapText="true">
                            <font><Font size="12.0" /></font>
                        </Label>
                    </children>
                </VBox>

                <!-- AZIONI -->
                <HBox alignment="CENTER_RIGHT" spacing="12.0" maxWidth="500.0">
                    <children>
                        <Button text="Annulla" onAction="#cancelButton" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-border-color: #3a3a3a; -fx-border-radius: 18; -fx-background-radius: 18; -fx-pref-height: 36; -fx-font-size: 13px; -fx-cursor: hand;" />
                        <Button text="Salva" onAction="#saveProfile" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                style="-fx-background-color: white; -fx-text-fill: black; -fx-background-radius: 18; -fx-pref-height: 36; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;" />
                    </children>
                </HBox>
            </children>
        </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
