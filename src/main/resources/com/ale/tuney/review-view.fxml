<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane
        prefHeight="800.0" prefWidth="1280.0"
        style="-fx-background-color: #090909;"
        stylesheets="@style.css"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.ale.tuney.controller.ReviewController">
    <padding><Insets bottom="10" left="10" right="10" top="10"/></padding>

    <!-- CENTRO -->
    <center>
        <VBox alignment="TOP_CENTER" spacing="20"
              style="-fx-background-color: #141414; -fx-background-radius: 16;">
            <padding><Insets bottom="30" left="50" right="50" top="30"/></padding>
            <children>

                <Label text="Nuova Recensione" textFill="WHITE">
                    <font><Font name="System Bold" size="28"/></font>
                </Label>

                <!-- Barra di ricerca e tendina risultati -->
                <VBox maxWidth="500" spacing="0">
                    <children>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <children>
                                <TextField fx:id="searchField"
                                           prefHeight="44.0"
                                           promptText="Cerca..."
                                           style="-fx-background-color: #0d0d0d;
                                                  -fx-text-fill: white;
                                                  -fx-background-radius: 12;
                                                  -fx-prompt-text-fill: #555;
                                                  -fx-font-size: 14;"
                                           HBox.hgrow="ALWAYS"/>
                                <Button onAction="#search" prefHeight="44.0" prefWidth="90"
                                        style="-fx-background-color: #6b3fa0;
                                               -fx-text-fill: white;
                                               -fx-background-radius: 12;
                                               -fx-cursor: hand;">
                                    <font><Font name="System Bold" size="13.0" /></font>
                                    <graphic>
                                        <Label text="CERCA" textFill="white">
                                            <font><Font name="System Bold" size="13"/></font>
                                        </Label>
                                    </graphic>
                                </Button>
                            </children>
                        </HBox>
                        <!-- Tendina risultati -->
                        <ListView fx:id="resultsListView"
                                  managed="false" visible="false"
                                  onMouseClicked="#selectResult"
                                  prefHeight="250"
                                  style="-fx-background-color: #1a1a1a;
                                         -fx-border-color: #333;
                                         -fx-border-width: 0 1 1 1;"/>
                    </children>
                </VBox>

                <!-- Form recensione -->
                <VBox fx:id="reviewForm" alignment="CENTER"
                      managed="false" visible="false" spacing="16">
                    <children>

                        <ImageView fx:id="albumCover"
                                   fitHeight="180" fitWidth="180"
                                   pickOnBounds="true" preserveRatio="true"/>

                        <VBox alignment="CENTER" spacing="4">
                            <children>
                                <Label fx:id="titleLabel" text="" textFill="WHITE">
                                    <font><Font name="System Bold" size="20"/></font>
                                </Label>
                                <Label fx:id="artistLabel" text="" textFill="#b3b3b3">
                                    <font><Font size="15"/></font>
                                </Label>
                            </children>
                        </VBox>

                        <!-- Stelline cliccabili -->
                        <HBox fx:id="starsBox" alignment="CENTER" spacing="8">
                            <children>
                                <Label fx:id="star1" text="★"
                                       style="-fx-text-fill: #444; -fx-cursor: hand;">
                                    <font><Font size="40"/></font>
                                </Label>
                                <Label fx:id="star2" text="★"
                                       style="-fx-text-fill: #444; -fx-cursor: hand;">
                                    <font><Font size="40"/></font>
                                </Label>
                                <Label fx:id="star3" text="★"
                                       style="-fx-text-fill: #444; -fx-cursor: hand;">
                                    <font><Font size="40"/></font>
                                </Label>
                                <Label fx:id="star4" text="★"
                                       style="-fx-text-fill: #444; -fx-cursor: hand;">
                                    <font><Font size="40"/></font>
                                </Label>
                                <Label fx:id="star5" text="★"
                                       style="-fx-text-fill: #444; -fx-cursor: hand;">
                                    <font><Font size="40"/></font>
                                </Label>
                            </children>
                        </HBox>

                        <!-- Testo recensione -->
                        <TextArea fx:id="reviewText"
                                  maxWidth="500" prefHeight="120"
                                  promptText="Cosa ne pensi?"
                                  wrapText="true"
                                  style="-fx-control-inner-background: #090909;
                                       -fx-text-fill: white;
                                       -fx-border-color: #333;
                                       -fx-background-radius: 8;
                                       -fx-font-size: 14px;
                                       -fx-focus-color: transparent;
                                       -fx-faint-focus-color: transparent;"/>

                        <!-- Errore e progress -->
                        <Label fx:id="errorLabel" text="" textFill="#e74c3c"
                               managed="false" visible="false">
                            <font><Font size="12"/></font>
                        </Label>
                        <ProgressIndicator fx:id="progressIndicator"
                                           prefWidth="28" prefHeight="28"
                                           managed="false" visible="false"/>

                        <!-- Bottoni -->
                        <HBox alignment="CENTER" spacing="20" maxWidth="500">
                            <VBox.margin><Insets top="20"/></VBox.margin>
                            <children>
                                <Button fx:id="submitButton" onAction="#onSubmitReview" prefHeight="48"
                                        maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                        style="-fx-background-color: #6b3fa0; -fx-text-fill: white; -fx-background-radius: 24; -fx-cursor: hand;"
                                        text="PUBBLICA">
                                    <font><Font name="System Bold" size="15"/></font>
                                </Button>
                                <Button onAction="#cancelReview" prefHeight="48"
                                        maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                        style="-fx-background-color: transparent;
                       -fx-text-fill: white;
                       -fx-border-color: #555;
                       -fx-border-radius: 24;
                       -fx-cursor: hand;"
                                        text="ANNULLA">
                                    <font><Font name="System Bold" size="15"/></font>
                                </Button>
                            </children>
                        </HBox>

                    </children>
                </VBox>

            </children>
        </VBox>
    </center>

</BorderPane>
