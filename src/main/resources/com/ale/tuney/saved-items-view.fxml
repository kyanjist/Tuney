<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane
        prefHeight="800.0" prefWidth="1280.0"
        style="-fx-background-color: #090909;"
        stylesheets="@style.css"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.ale.tuney.controller.SavedItemsController">

    <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>

    <!-- CENTRO -->
    <center>
        <VBox alignment="TOP_CENTER" spacing="0"
              style="-fx-background-color: #141414; -fx-background-radius: 16;">
            <padding><Insets bottom="30.0" left="50.0" right="50.0" top="30.0" /></padding>
            <children>

                <HBox alignment="CENTER_LEFT">
                    <VBox.margin><Insets bottom="20"/></VBox.margin>
                    <children>
                        <Label text="Elementi salvati" textFill="WHITE">
                            <font><Font name="System Bold" size="28.0" /></font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <ChoiceBox fx:id="sortChoice" prefWidth="180" />
                    </children>
                </HBox>

                <StackPane VBox.vgrow="ALWAYS">
                    <children>
                        <!-- Messaggio nessun risultato -->
                        <VBox fx:id="emptyVBox" alignment="CENTER" spacing="12.0" visible="false" managed="false">
                            <children>
                                <Label text="Tutto ciò che non vuoi perderti!" textFill="#888888">
                                    <font><Font name="System Bold" size="18.0" /></font>
                                </Label>
                                <Label text="Salva canzoni e album per ritrovarli qui." textFill="#666666">
                                    <font><Font size="14.0" /></font>
                                </Label>
                            </children>
                        </VBox>

                        <!-- Griglia elementi salvati -->
                        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                                    VBox.vgrow="ALWAYS"
                                    style="-fx-background: #141414; -fx-background-color: #141414; -fx-border-color: transparent; -fx-border-width: 0; -fx-background-insets: 0; -fx-padding: 0;">
                            <content>
                               <VBox spacing="16.0" alignment="TOP_CENTER" style="-fx-background-color: #141414;">
                                  <padding><Insets bottom="16.0" left="15.0" right="15.0" top="16.0" /></padding>
                                  <children>
                                     <FlowPane fx:id="feedPane" hgap="16.0" vgap="16.0" alignment="TOP_LEFT" maxWidth="-Infinity" prefWrapLength="1200.0" />
                                  </children>
                               </VBox>
                            </content>
                        </ScrollPane>
                    </children>
                </StackPane>

            </children>
        </VBox>
    </center>

</BorderPane>
