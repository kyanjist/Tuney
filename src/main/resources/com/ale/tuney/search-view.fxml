<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane
        prefHeight="800.0" prefWidth="1280.0"
        style="-fx-background-color: #090909;"
        stylesheets="@style.css"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.ale.tuney.controller.SearchController">

    <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>

    <!-- CENTRO -->
    <center>
        <VBox alignment="TOP_CENTER" spacing="0"
              style="-fx-background-color: #141414; -fx-background-radius: 16;">
            <padding><Insets bottom="30.0" left="50.0" right="50.0" top="30.0" /></padding>
            <children>

                <Label text="Cerca" textFill="WHITE">
                    <font><Font name="System Bold" size="28.0" /></font>
                    <VBox.margin><Insets bottom="20"/></VBox.margin>
                </Label>

                <!-- Barra di ricerca -->
                <VBox maxWidth="540.0" spacing="0">
                    <children>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <children>
                                <TextField fx:id="searchField"
                                           prefHeight="44.0"
                                           promptText="Cerca brani, album, utenti..."
                                           style="-fx-background-color: #0d0d0d;
                                                  -fx-text-fill: white;
                                                  -fx-background-radius: 12;
                                                  -fx-prompt-text-fill: #555;
                                                  -fx-font-size: 14;"
                                           HBox.hgrow="ALWAYS"/>
                                <Button onAction="#search" prefHeight="44.0" prefWidth="90"
                                        style="-fx-background-color: #6b3fa0;
                                               -fx-text-fill: white;
                                               -fx-background-radius: 12;
                                               -fx-cursor: hand;">
                                    <font><Font name="System Bold" size="13.0" /></font>
                                    <graphic>
                                        <Label text="CERCA" textFill="white">
                                            <font><Font name="System Bold" size="13"/></font>
                                        </Label>
                                    </graphic>
                                </Button>
                            </children>
                        </HBox>

                        <!-- Chip filtro -->
                        <HBox fx:id="filtriBox" spacing="8" alignment="CENTER_LEFT">
                            <VBox.margin><Insets top="12" bottom="4"/></VBox.margin>
                            <children>
                                <Button fx:id="allChip" onAction="#allFilter"
                                        text="Tutti" prefHeight="30"
                                        style="-fx-background-color: #6b3fa0; -fx-text-fill: white;
                                               -fx-background-radius: 20; -fx-cursor: hand; -fx-font-size: 12;">
                                </Button>
                                <Button fx:id="tracksChip" onAction="#tracksFilter"
                                        text="Brani" prefHeight="30"
                                        style="-fx-background-color: #2a2a2a; -fx-text-fill: #aaa;
                                               -fx-background-radius: 20; -fx-cursor: hand; -fx-font-size: 12;">
                                    <graphic>
                                        <SVGPath content="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z" fill="#aaaaaa" scaleX="0.65" scaleY="0.65"/>
                                    </graphic>
                                </Button>
                                <Button fx:id="albumsChip" onAction="#albumsFilter"
                                        text="Album" prefHeight="30"
                                        style="-fx-background-color: #2a2a2a; -fx-text-fill: #aaa;
                                               -fx-background-radius: 20; -fx-cursor: hand; -fx-font-size: 12;">
                                    <graphic>
                                        <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 14.5c-2.49 0-4.5-2.01-4.5-4.5S9.51 7.5 12 7.5s4.5 2.01 4.5 4.5-2.01 4.5-4.5 4.5zm0-5.5c-.55 0-1 .45-1 1s.45 1 1 1 1-.45 1-1-.45-1-1-1z" fill="#aaaaaa" scaleX="0.65" scaleY="0.65"/>
                                    </graphic>
                                </Button>
                                <Button fx:id="usersChip" onAction="#usersFilter"
                                        text="Utenti" prefHeight="30"
                                        style="-fx-background-color: #2a2a2a; -fx-text-fill: #aaa;
                                               -fx-background-radius: 20; -fx-cursor: hand; -fx-font-size: 12;">
                                    <graphic>
                                        <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="#aaaaaa" scaleX="0.65" scaleY="0.65"/>
                                    </graphic>
                                </Button>
                            </children>
                        </HBox>

                        <!-- Tendina risultati -->
                        <ListView fx:id="resultsList"
                                  managed="false" visible="false"
                                  onMouseClicked="#selectResult"
                                  prefHeight="380.0"
                                  style="-fx-background-color: #0d0d0d;
                                         -fx-border-color: #2a2a2a;
                                         -fx-border-width: 0 1 1 1;
                                         -fx-border-radius: 0 0 12 12;"/>
                    </children>
                </VBox>

                <!-- Messaggio nessun risultato -->
                <Label fx:id="noResultLabel" text="Nessun risultato trovato"
                       textFill="#555" managed="false" visible="false">
                    <font><Font size="14.0" /></font>
                    <VBox.margin><Insets top="24"/></VBox.margin>
                </Label>

            </children>
        </VBox>
    </center>

</BorderPane>
