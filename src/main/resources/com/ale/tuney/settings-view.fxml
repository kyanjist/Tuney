<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane
        prefHeight="800.0" prefWidth="1280.0"
        style="-fx-background-color: #090909;"
        stylesheets="@style.css"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.ale.tuney.controller.SettingsController">

    <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>

    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background: #141414; -fx-background-color: #141414; -fx-border-color: transparent; -fx-border-width: 0; -fx-background-insets: 0; -fx-padding: 0; -fx-background-radius: 16;">
            <content>
                <VBox alignment="TOP_CENTER" spacing="24.0" style="-fx-background-color: #141414; -fx-background-radius: 16;">
                    <padding><Insets bottom="40.0" left="50.0" right="50.0" top="30.0" /></padding>
                    <children>

                        <Label text="Impostazioni" textFill="WHITE">
                            <font><Font name="System Bold" size="28.0" /></font>
                            <VBox.margin><Insets bottom="10"/></VBox.margin>
                        </Label>



                        <!-- SEZIONE CAMBIO PASSWORD -->
                        <VBox spacing="15.0" alignment="TOP_LEFT" style="-fx-background-color: #090909; -fx-background-radius: 12; -fx-padding: 20;" maxWidth="600.0">
                            <children>
                                <Label text="Cambio Password" textFill="WHITE">
                                    <font><Font name="System Bold" size="18.0" /></font>
                                </Label>
                                <Label text="Aggiorna la tua password per mantenere l'account sicuro." textFill="#888888">
                                    <font><Font size="13.0" /></font>
                                    <VBox.margin><Insets bottom="5.0"/></VBox.margin>
                                </Label>
                                
                                <VBox spacing="6.0">
                                    <children>
                                        <Label text="Password Corrente" textFill="#b3b3b3">
                                            <font><Font size="13.0" /></font>
                                        </Label>
                                        <PasswordField fx:id="currentPasswordField" promptText="Inserisci password corrente"
                                                       style="-fx-background-color: #141414; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10;" />
                                    </children>
                                </VBox>

                                <VBox spacing="6.0">
                                    <children>
                                        <Label text="Nuova Password" textFill="#b3b3b3">
                                            <font><Font size="13.0" /></font>
                                        </Label>
                                        <PasswordField fx:id="newPasswordField" promptText="Inserisci nuova password"
                                                       style="-fx-background-color: #141414; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10;" />
                                    </children>
                                </VBox>

                                <VBox spacing="6.0">
                                    <children>
                                        <Label text="Conferma Nuova Password" textFill="#b3b3b3">
                                            <font><Font size="13.0" /></font>
                                        </Label>
                                        <PasswordField fx:id="confirmPasswordField" promptText="Conferma nuova password"
                                                       style="-fx-background-color: #141414; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10;" />
                                    </children>
                                </VBox>

                                <Label fx:id="pwdErrorLabel" textFill="#ff5555" wrapText="true" visible="false" managed="false">
                                    <font><Font size="13.0" /></font>
                                </Label>

                                <Button text="Aggiorna Password" onAction="#changePassword" styleClass="btn-settings-primary" />
                            </children>
                        </VBox>

                        <!-- SEZIONE ELIMINAZIONE ACCOUNT -->
                        <VBox spacing="10.0" alignment="TOP_LEFT" style="-fx-background-color: #090909; -fx-background-radius: 12; -fx-padding: 20;" maxWidth="600.0">
                            <children>
                                <Label text="Eliminazione Account" textFill="WHITE">
                                    <font><Font name="System Bold" size="18.0" /></font>
                                </Label>
                                <Label text="L'eliminazione dell'account è permanente e comporta la rimozione di tutti i dati associati, comprese recensioni, commenti e brani salvati." textFill="#888888" wrapText="true">
                                    <font><Font size="13.0" /></font>
                                </Label>
                                <Button text="Elimina Account" onAction="#deleteAccount" styleClass="btn-elimina" />
                            </children>
                        </VBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
